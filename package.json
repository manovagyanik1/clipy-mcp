{
  "name": "@clipy/mcp",
  "version": "0.15.1",
  "mcpName": "online.clipy/mcp",
  "description": "Clipy MCP server for agent-native video handoffs: search recording and imported-video memory, read context and browser evidence, record headless sessions, and update transcripts or edit recordings with scoped permissions.",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "clipy-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "clipy",
    "ai-agent",
    "agent-native",
    "agent-context",
    "video-context",
    "screen-recording",
    "semantic-search",
    "browser-diagnostics",
    "headless-recording",
    "transcript",
    "claude-code",
    "codex",
    "cursor"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "test": "npm run build && node scripts/agent-readiness.test.mjs && node scripts/arec-range.test.mjs && node scripts/browser-diagnostics.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manovagyanik1/clipy-mcp.git"
  },
  "homepage": "https://clipy.online/for-agents",
  "bugs": {
    "url": "https://github.com/manovagyanik1/clipy-mcp/issues"
  }
}
